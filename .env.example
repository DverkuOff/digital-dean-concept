# Скопируй в .env и впиши значения. .env не коммитится, Claude его не читает.
# Строка подключения к PostgreSQL (локально: docker compose up -d)
DATABASE_URL=
# Секрет Better Auth, минимум 32 случайных символа: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Публичный адрес приложения, например http://localhost:3100 или https://<имя>.amvera.io
BETTER_AUTH_URL=
